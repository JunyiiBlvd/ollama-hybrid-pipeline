# Required
PIPELINE_VAULT_PATH=./vault        # Path to your knowledge vault (skills, knowledge, memory)
OLLAMA_URL=http://127.0.0.1:11434  # Ollama API base URL (no trailing slash, no path)
PRIMARY_MODEL=qwen2.5:14b          # Primary inference model — used for coding, reasoning, domain tasks
FAST_MODEL=llama3.2                # Fast model for quick-lookup prompts. Set to PRIMARY_MODEL to route fast-classified prompts to your main model instead.

# Optional
PIPELINE_PORT=11436                # Pipeline API port (pipeline_api.py)
PIPELINE_STORAGE_PATH=./storage    # Base storage path (used by session-memory.py git root)

# Backend selection (backend.py adapter)
PIPELINE_BACKEND=ollama            # Active inference backend: ollama | llamacpp | vllm
LLAMACPP_URL=http://127.0.0.1:8080 # llama.cpp server base URL (used when PIPELINE_BACKEND=llamacpp)
VLLM_URL=http://127.0.0.1:8000     # vLLM server base URL (used when PIPELINE_BACKEND=vllm)
